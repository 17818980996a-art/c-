//实型（浮点型）
//作用：表示小数
//分类：1.单精度：float （七位有效数字）【4字节】
       2.双精度：double （15~16位有效数字）【8字节】
//默认情况下，输出一个小数，会显示出6位有效数字
include<iostream>
using namespace std;
int main()
{
    float f1 = 3.1415926f; //在数字后面加一个f，让系统更好判断这是一个单精度
    cout << f1 << endl;
    double d1 = 3.1415926
    cout << d1 << endl;
    return 0;
}
/*结果：3.14159
       3.14159
*/
