//结构体中const使用场景
//作用：用const来防止误操作
//注：将函数中的形参改为指针，可以减少内存空间，而且不会复制新的副本出来，加入const后形参就无法修改，防止误操作
eg:
struct student
{
    string name;
    int age;
};
void print2(const student *p) //此处的struct可以省略
{
    p->age = 922;
    cout << "子函数中：” << p->name << p->age << endl;
}
int main()
{
    struct studeent s;
    s.name = "nayeon";
    s.age = 1;
    print2(&s);
}//结果：子函数中：nayeon 1















