//引用
//作用：给变量起名
//语法：数据类型 &别名 = 原名
eg:
int a = 10;
int &b = a;
cout << a << endl;
cout << b << endl;
/*结果：
10
10
*/
b = 100;
cout << a << endl;
cout << b << endl;
/*结果：
100
100
*/

