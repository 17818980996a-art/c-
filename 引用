//引用做函数参数
//作用：函数传参时，可以利用引用的技术让形参修饰实参
//优点：可以简化指针修改实参
eg:引用传递【形参会修饰实参】
(注意与地址传递【形参会修饰实参】和值传递【形参不会修饰实参】进行语法上的区分)
void myswap(int &a, int &b) //此时的a和b是别民——别名可以和原名一致
{
    int temp = a;
    a = b
    b = temp;
}
int main()
{
    int a = 1;
    int b = 2;
    myswap(a , b);
    cout << a << endl;
    cout << b << endl;
    return 0;
}
/*结果：
2
1
*/

//引用做函数返回值
//作用：引用可以作为函数的返回值存在
//注意：不要返回局部变量引用
eg:
int& test()
{
    int a = 1;
    return a;
}

//会报错
//用法：函数调用作为左值
eg1:
int& test()
{
    int a = 10;
    return a;
}
int main()
{
    int &ref = test();
    cout << ref << endl;
}//结果：10  只能打印一次

eg2:
int& test2()
{
    static int a = 10;//用静态变量,存放在全局区，全局区上的数据在程序结束后系统释放
    return a;
}
int main()
{
    int &ref2 = test2();
    cout << ref2 << endl;
    return 0;
}
//结果：10   可以打印多次

//引用的本质
//本质：在c++内部实现是一个指针常量
eg:
int& ref = a;//相当于 int * const ref = &a;
//指针常量的指向不可以修改，但是值可以修改
ref = 20;//相当于 *ref = 20；

//常量引用
//作用：主要用来修饰形参，防止误操作
//在函数形参列表中，可以加const修饰形参，防止形参改变实参
eg1：
const int & ref = 10;
ref = 20;//加上const后变为只读，不能修改，会报错
eg2:
void showvalue(const int &val) //加上const
{
    val = 1000;// 不能修改，会报错
    cout << val << endl;
}
























