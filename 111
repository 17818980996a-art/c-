//对象的初始化和清理
//c++利用构造函数和析构函数完成对象初始化和清理工作，这是编译器强制要求做的，因此如果我们不提供构造和析构，编译器会提供，且编译器提供的构造函数和析构函数是空实现

//构造函数：主要作用在于创建对象时为对象的成员属性赋值，构造函数由编译器自动调用，无需手动调用
//语法： 类名(){}
/*注：
1.不需要返回值也不需要void
2.函数名称与类名相同
3.构造函数可以有参数，因此可以发生重载
4.程序在调用对象的时候会自动调用构造，无须手动调用，而且只会调用一次
*/
eg:
class person
{
public:
    person()
    {
        cout << "person构造函数的调用" << endl;
    }
};
int main()
{
    person p;
    return 0;
}//结果：person构造函数的调用

//析构函数：主要作用于在对象销毁前系统自动调用，执行一些清理工作
//语法：~类名(){}
/*注：
1.不需要返回值也不需要void
2.函数名称与类名相同，在名称前加上符号 ~
3.析构函数不可以有参数，因此不可以发生重载
4.程序在对象销毁前会自动调用析构，无需手动调用，而且只会调用一次
*/
eg:
class person
{
public:
    ~person() //这里不可以有参数
    {
        cout << "person析构函数的调用" << endl;
    }
};
int main()
{
    person p;
    return 0;
}//结果：person析构函数的调用

//构造函数的分类及调用
/*两种分类方式：
1.按参数分为：有参构造和无参构造(默认构造)
2.按类型分为：普通构造和拷贝构造
eg:
class Person 
{
public:
    Person()
    {
        cout << "Person的无参构造函数调用" << endl;
    }
    Person(int a)
    {
        age = a;
        cout << "Person的有参构造函数调用" << endl;
    }
    //拷贝构造函数
    Person(const Person &p)
    {
        //将传入的人身上的所有属性（age），拷贝到p身上
        cout << "Person的拷贝构造函数调用" << endl;
        age = p.age;
    }
    ~Person()
    {
        cout << "Person的析构函数调用" << endl;
    }
    int age;
};

*/
/*三种调用方式：
1.括号法
2。显示法
3。隐式转换法
*/
eg:调用
void test1()
{
    //1、括号法
    //注：调用默认构造函数的时候不要加()
    Person p1; //默认构造函数调用  //结果：Person的无参构造函数调用\n Person的析构函数调用
    Person p2(10); //有参构造函数  //结果：Person的有参构造函数调用\n Person的析构函数调用
    Person p3(p2); //拷贝构造函数调用 //结果：Person的拷贝构造函数调用\n Person的析构函数调用

    cout << "p2的年龄为：" << p2.age << endl; //结果：p2的年龄为：10
    cout << "p3的年龄为：" << p3.age << endl; //结果：p3的年龄为：10

    //2、显示法
    Person p1;
    Person p2 = Person(10);//有参构造  
    Person p3 = Person(p2);//拷贝构造

    /*
    Person(10)    叫做匿名对象 特点：当前行执行结束后，系统会立即回收掉匿名对象
    cout << "aaa" << endl;
    结果：Person的有参构造函数调用\n Person的析构函数调用\n aaa
    */

    /*注：
    不要利用拷贝构造函数初始化匿名对象
    Person(p3); 会报错 编译器会认为Person（p3） == Person p3; 这是一个对象的声明
    */

    //3、隐式转换法
    Person p4 = 10；//相当于写了Person p4 =Person(10);
    //结果：Person的有参构造函数调用\n Person的析构函数调用
    Person p5 = p4; //拷贝构造
}
int main()
{
    test1();
    return 0;
}


//拷贝构造函数调用时机
/*c++中拷贝构造函数调用时机通常由三种情况
1.使用一个已经创建完毕的对象来初始化一个新对象
2.值传递的方式给函数参数传值
3.以值方式返回局部对象
*/
class Person
{
public:
    Person()
    {
        cout << "Person默认构造函数调用" << endl;
    }

    Person(int age)
    {
        cout << "Person有参构造函数调用" << endl;
        mage = age;
    }

    Person(const Person &p)
    {
        cout << "Person拷贝构造函数调用" << endl;
        mage = p.mage;
    }

    ~Person()
    {
        cout << "Person析构函数调用" << endl;
    }
    int mage;
};

//1.使用一个已经创建完毕的对象来初始化一个新对象
void test1()
{
    Person p1(20); //结果：Person的有参构造函数调用\n Person的析构函数调用
    Person p2(p1); //结果：Person的拷贝构造函数调用\n Person的析构函数调用

    cout << "p2的年龄为：“ << p2.mage << endl; //结果：p2的年龄为20
}

//2.值传递的方式给函数参数传值
void dowork(Person p)
{
}
void test2()
{
    Person p;
    dowork(p);
}

//3.以值方式返回局部对象
Person dowork2()
{
    Person p1;
    return p1;
}
void test3()
{
    Person p = dowork2();
}

