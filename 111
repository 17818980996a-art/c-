//类和对象
//c++面对对象的三大特性：封装、继承、多态
//c++认为万事万物都皆为对象，对象上有其属性和行为
/*注：
1.类中的属性和行为统一称为成员
2.属性叫成员属性或成员变量
3.行为叫成员函数或成员方法
*/


//封装
/*意义：
1.将属性和行为作为一个整体，表现生活中的事物
语法： class 类名{  访问权限： 属性/行为 }；
eg1:
class Circle
{
    public: //访问权限、
    int m_r;
    double calculateZC()
    {
        return 2 * PI * m_r;
    }
};
int main()
{
    Circle cl; //cl是变量名称
    cl.m_r = 10; //给圆对象的属性进行赋值
    cout << cl.calculateC() << endl;
    return 0;
}
eg2:
class student
{
    public:
    //属性
    string name;
    int id;

    //行为
    void stushow()
    {
        cout << name << id << endl;
    }
};
int main()
{
    student stu;
    stu.name = "nayeon";
    stu.id = 922;
