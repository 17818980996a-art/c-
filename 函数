//函数的声明
//作用：告诉编译器函数名称及如何调用函数，函数实际的主体可以单独定义
//注：函数的声明可以多次，但函数的定义只能有一次
eg:
int max(int a,int b);//提前声明就可以将自己定于的函数写在后面
int main()
{
    cout << max(a,b) << endl;
}
int max(int a,int b)
{
    return a > b ? a : b;
}

