//指针
//作用：间接访问内存
/*注意：
1.内存编号是从0开始记录的，一般用十六进制数字表示
2.可以利用指针变量保存地址
*/
//指针变量定义语法：数据类型 * 变量名；
eg:
int a = 10;
int * p;
p = &a;//取址符号，前面说过
cout << &a << endl;
cout << p << endl;
*p = 1000;
cout << a << endl;
cout << *p << endl;
/*结果：(指针既可以访问也可以修改)
0053F754
0053F754
1000
1000
*/

//指针所占内存空间
/*
在32位操作系统下：占用4个字节空间
在64位操作系统下：占用8个字节空间
*/
eg:
int a = 10;
int * p =&a;
cout << sizeof(int *) << endl;
cout << sizeof(p) << endl; //int * 或者 p都可以

//空指针：指针变量指向内存中编号为0的空间
eg: int * p = NULL;
//作用：初始化指针变量
//注意：空指针指向的内存是不可以访问的
eg: cout << *p << endl; //会报错

//野指针：指针变量指向非法的内存空间
eg:
int * p =(int *)0x1100;
//注意：野指针指向的内存是不可以访问的
eg:
cout << *p << endl; //会报错
//总结：空指针和野指针都不是我们申请的空间，所以不要访问

//const修饰指针
/*情况：
1.const修饰指针：常量指针（指针的指向可以修改但是指针指向的值不可以改）
eg:
int a = 10;
int b = 10;
int * p = &a;

const int * p =&a;
*p = 20; //错误。指针指向的值不能修改
p = &b; //正确，指针指向可以改
2.const修饰常量：指针常量(指针的指向不可以修改，指针指向的值可以修改)
int * const p = &a;
*p = 20; //正确
 p = &b; //错误
3.const既修饰指针，又修饰常量(指针的指向和指针指向的值都不可以改)
eg:
const int const * p = &a;

//指针和数组
//作用：利用指针访问数组中的元素
eg:
int arr[3] = {1,2,3};
int *p = arr;//arr就是数组首地址
cout << *p << endl;//利用指针访问第一个元素
结果：1
p++;//让指针偏移4个字节
cout << *p << endl; //利用指针访问第二个元素
结果：2
