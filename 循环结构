//循环结构
//语法：while(循环条件){循环语句}
//只要循环条件的结构为真，就执行循环语句
eg：
int num = 0;
while (num < 10)
{
    cout << num << endl;
    num++;
}//结果输出0~9

//可以利用break; 退出循环
//猜数字实例
#include <iostream>
#include <ctime>
#include <cstdlib>
using namespace std;

int main()
{
	srand((unsigned int)time(NULL));
	int num = rand() % 100 + 1;
	int num1 = 0;
	while (1)
	{
		cin >> num1;

		if (num1 < num) 
		{
			cout << "too small" << endl;
		}
		else if (num1 > num)
		{
			cout << "too big" << endl;
		}
		else
		{
			cout << "correct" << endl;
			break;
		}
		
	}
	return 0;
}

//do…while循环语句
//语法：do{循环语句}while(循环条件);
//注意：与while的区别在于do…while会先执行一次循环语句，再判断循环条件
eg：输出0~9
int num = 0;
do
{
    cout << num << endl;
    num++;
}
while (num < 10);

//for循环语句
//语法：for(起始表达式；条件表达式；末尾循环体){循环语句；}
eg1：打印数字0~9
for(int i = 0; i<10; i++)
{
    cout << i << endl;
}
eg2:打印数字0~9
int i = 0;
for(;;)
{
    if (i >= 10)
    {
        break;
    }
    cout << i << endl;
    i++;
}

//嵌套循环
//在循环体中再嵌套一层循环，解决实际问题
eg:打印出星图
for (int i = 0; i<10; i++)
{
	for (int i = 0; i < 10; i++)
	{
		cout << "*" << i << endl;
	}
	cout << endl;
}

eg2:打印九九乘法表
for (int i = 1; i <= 9; i++)
{
	for (int j = 1; j <= i; j++)
	{
		cout << j << "*" << i << "=" << j*i << "\t";
	}
	cout << endl;
}

//跳转语句
//作用：跳出选择结构或者循环结构
/*break：
1.switch语句中，终止case并跳出switch
2.循环语句中，跳出当前的循环语句
3.嵌套循环中，跳出最近的内层循环语句
*/
/*continue:在循环语句中，跳过本次循环，继续执行下一次循环
eg:只输出奇数不输出偶数
for (int i = 0;i <= 10; i++)
{
	cout << i << endl;
	if (i % 2 == 0)
	{
		continue;//如果是brek结果是什么都没有
	}
}//结果：只输出奇数

//goto语句
